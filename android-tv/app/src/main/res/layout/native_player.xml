<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/native_player_surface"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:surface_type="surface_view" app:use_controller="false"
        app:resize_mode="fit" app:show_buffering="never"
        app:shutter_background_color="#000000" android:background="#000000" />
    <FrameLayout android:id="@+id/native_player_overlay"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
